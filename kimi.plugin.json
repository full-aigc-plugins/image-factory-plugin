{
  "name": "image-factory",
  "version": "0.7.0",
  "description": "Discover prompts, batch-produce and evaluate images, and record verified artifact receipts.",
  "author": {
    "name": "Full Stack Skills / PartMe.AI"
  },
  "homepage": "https://github.com/full-aigc-plugins/image-factory-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "image",
    "batch",
    "receipts"
  ],
  "interface": {
    "displayName": "Image Factory",
    "shortDescription": "Discover, batch-produce, and evaluate images",
    "longDescription": "Host-aware direct image generation with native capability preferred and Baoyu fallback when appropriate, plus governed batch production with prompt discovery, verified receipts, evaluation, and recovery.",
    "developerName": "Full Stack Skills / PartMe.AI",
    "websiteURL": "https://github.com/full-aigc-plugins/image-factory-plugin"
  },
  "skills": "./skills/",
  "commands": "./commands/",
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./hooks/env_check.py",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/check_factory_intent.py",
      "timeout": 15
    }
  ]
}
