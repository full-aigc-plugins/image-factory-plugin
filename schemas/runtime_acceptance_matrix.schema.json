{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/image-factory-plugin/schemas/runtime_acceptance_matrix.schema.json",
  "title": "RuntimeAcceptanceMatrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plugin_version": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "kind", "status", "host", "plugin_version", "model", "provider", "prompt_strategy", "started_at", "ended_at", "evidence_tier", "evidence_refs", "fault_proof", "notes"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["paid_story", "cross_host", "model_comparison", "fault"]},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
        "host": {"type": "string", "minLength": 1},
        "plugin_version": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "prompt_strategy": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]},
        "evidence_tier": {"enum": ["none", "synthetic", "live_runtime"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fault_proof": {"type": ["object", "null"], "additionalProperties": false,
          "required": ["duplicate_paid_calls", "recovery_handle_preserved", "artifact_misattributed", "external_calls", "final_state"],
          "properties": {
            "duplicate_paid_calls": {"type": "boolean"},
            "recovery_handle_preserved": {"type": "boolean"},
            "artifact_misattributed": {"type": "boolean"},
            "external_calls": {"type": "integer", "minimum": 0},
            "final_state": {"type": "string", "minLength": 1}
          }
        },
        "story_proof": {"type": ["object", "null"], "additionalProperties": false,
          "required": ["shot_count", "verified_receipt_count", "human_labeled_count", "paid_call_count", "receipt_refs", "human_label_refs", "elapsed_seconds", "observed_cost"],
          "properties": {
            "shot_count": {"type": "integer", "minimum": 1},
            "verified_receipt_count": {"type": "integer", "minimum": 0},
            "human_labeled_count": {"type": "integer", "minimum": 0},
            "paid_call_count": {"type": "integer", "minimum": 0},
            "receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "human_label_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
            "observed_cost": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
