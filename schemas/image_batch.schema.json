{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/image-factory-plugin/schemas/image_batch.schema.json",
  "title": "ImageBatchPlan",
  "description": "A batch of image production items. Generation inputs are the compiled prompt and at most five ordered reference images; the built-in Codex image tool accepts no size, quality, background, count, or model argument.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "round",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3.0"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "limits": {
      "$ref": "#/$defs/batchLimits"
    },
    "judge_policy": {
      "$ref": "#/$defs/judgePolicy"
    },
    "consistency_profile": {
      "$ref": "#/$defs/consistencyProfile"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/batchItem"
      }
    }
  },
  "$defs": {
    "batchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "reference_images": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/itemReference"
          }
        },
        "entity_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          }
        },
        "allowed_variations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "pixel_checks": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "corner-colour",
                  "min-margin",
                  "ink-colour"
                ]
              },
              "r": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "g": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "b": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "tolerance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "min_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.45
              }
            }
          }
        }
      }
    },
    "itemReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "identity",
            "style",
            "prop",
            "layout",
            "edit_target",
            "generic"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      }
    },
    "consistencyEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "fixed_traits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "character",
            "prop",
            "element"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "fixed_traits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "reference_images": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "consistencyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "style_bible",
        "entities"
      ],
      "properties": {
        "mode": {
          "const": "series"
        },
        "style_bible": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "negative_constraints": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "style_reference_images": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entities": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/consistencyEntity"
          }
        }
      }
    },
    "batchLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_images",
        "max_rounds",
        "require_approval_before_run"
      ],
      "properties": {
        "max_images": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "require_approval_before_run": {
          "const": true
        }
      }
    },
    "judgePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_dimension",
        "reject_duplicates",
        "pass_threshold",
        "require_human_labels"
      ],
      "properties": {
        "min_dimension": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "reject_duplicates": {
          "type": "boolean"
        },
        "pass_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "advisory_enabled": {
          "type": "boolean"
        },
        "require_human_labels": {
          "const": true
        }
      }
    }
  }
}
