{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/image-factory-plugin/schemas/image_batch.schema.json",
  "title": "ImageBatchPlan",
  "description": "A batch of image production items. Differences between items can only come from the prompt and the reference images: the built-in Codex image tool accepts no size, quality, background, count, or model argument.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "round", "items"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "round": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "limits": {"$ref": "#/$defs/batchLimits"},
    "judge_policy": {"$ref": "#/$defs/judgePolicy"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/batchItem"}
    }
  },
  "$defs": {
    "batchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 8000},
        "reference_images": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "batchLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_images", "max_rounds", "require_approval_before_run"],
      "properties": {
        "max_images": {"type": "integer", "minimum": 1, "maximum": 200},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 20},
        "require_approval_before_run": {"const": true}
      }
    },
    "judgePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_dimension", "reject_duplicates", "pass_threshold", "require_human_labels"],
      "properties": {
        "min_dimension": {"type": "integer", "minimum": 16, "maximum": 4096},
        "reject_duplicates": {"type": "boolean"},
        "pass_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "advisory_enabled": {"type": "boolean"},
        "require_human_labels": {"const": true}
      }
    }
  }
}
